#pragma once
#include <cstdio>
#include "../../local_event_planner/header/brent_hashing.h"
#include "../../local_event_planner/header/event.h"

/**
 * @brief Loads all users from binary file into hash table.
 */
int loadUsersFromBinaryFile(HashTable* ht, const char* filename);

/**
 * @brief Saves all users from hash table into binary file.
 */
int saveUsersToBinaryFile(const HashTable* ht, const char* filename);

/**
 * @brief Finds next available integer ID in a binary file.
 */
int getNextID(const char* filename, size_t recordSize);

/**
 * @brief Returns current date as string ("YYYY-MM-DD") with optional offset.
 */
char* getFormattedDate(int daysToAdd);



// === EVENT FILE FUNCTIONS ===
int save_event_to_file(const Event* e);
int load_all_events(Event** arr);
int save_sorted_events(const Event* arr, int count);
int get_next_event_id(void);