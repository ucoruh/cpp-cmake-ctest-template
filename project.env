# Project identity - the ONE place to rename this project.
# Read by every script (scripts/load-project-env-*), every GitHub workflow,
# the Python tools (tools/projectenv.py), CMake (CMakeLists.txt) and MkDocs.
# Format: KEY=value, one per line, no spaces around "=", no quotes.
PROJECT_NAME=calculator
VERSION=1.1.1
# owner/repository on GitHub (used for the site URL, release links and badges)
GITHUB_REPO=ucoruh/cpp-cmake-ctest-template
